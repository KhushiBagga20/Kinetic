# ─── Kinetic configuration ───────────────────────────────────────────────────
# Copy to .env and edit. Every value has a working default; nothing here is
# required to run the app.

# ─── Local model (MLX, Apple Silicon) ────────────────────────────────────────
KINETIC_LLM_MODEL=mlx-community/gemma-4-26b-a4b-it-4bit
KINETIC_LLM_AUTOLOAD=false        # true loads the weights at startup
KINETIC_LLM_MAX_TOKENS=1536
KINETIC_LLM_TEMPERATURE=0.2
KINETIC_LLM_THINKING=false        # true shows Gemma's reasoning channel
KINETIC_LLM_MAX_TOOL_STEPS=4

# ─── Retrieval ───────────────────────────────────────────────────────────────
KINETIC_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
KINETIC_CHUNK_SIZE=900
KINETIC_CHUNK_OVERLAP=180
KINETIC_RETRIEVAL_K=5
KINETIC_MIN_RELEVANCE=0.15

# ─── Market data ─────────────────────────────────────────────────────────────
KINETIC_INDEX_SYMBOLS=^NSEI,^BSESN,^NSEBANK,^INDIAVIX,^GSPC,BTC-USD
KINETIC_DEFAULT_SYMBOL=RELIANCE.NS
KINETIC_HISTORY_PERIOD=6mo
KINETIC_AUTO_REFRESH_SEC=60

# ─── You ─────────────────────────────────────────────────────────────────────
# Holdings are converted into this currency using a live FX rate. Your profile,
# watchlist and holdings live in data/preferences.json and data/portfolio.json,
# both git-ignored and never uploaded.
KINETIC_BASE_CURRENCY=INR
KINETIC_PORTFOLIO_FILE=

# ─── Forecast weights (renormalised over the legs that return data) ──────────
KINETIC_WEIGHT_TECHNICAL=0.40
KINETIC_WEIGHT_SENTIMENT=0.25
KINETIC_WEIGHT_FUNDAMENTAL=0.25
KINETIC_WEIGHT_DOCUMENTS=0.10
KINETIC_FORECAST_HORIZON_DAYS=10

# ─── Optional API keys ───────────────────────────────────────────────────────
# Quotes, history, fundamentals, news and screeners all work without any key.
NEWS_API_KEY=
ALPHA_VANTAGE_API_KEY=
FMP_API_KEY=
