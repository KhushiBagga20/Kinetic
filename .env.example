# ─── Personal Investment Research Agent ───────────────────────────────────────
# Copy this file to .env and fill in your API keys
# ──────────────────────────────────────────────────────────────────────────────

# Alpha Vantage — https://www.alphavantage.co/support/#api-key
# Used for: backup stock data, technical indicators, forex
# Free tier: 25 API calls/day
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here

# NewsAPI — https://newsapi.org/register
# Used for: market news headlines by ticker/topic
# Free tier: 100 requests/day
NEWS_API_KEY=your_newsapi_key_here

# Financial Modeling Prep (Optional) — https://financialmodelingprep.com/developer
# Used for: financial statements, ratios, DCF models
# Free tier: 250 API calls/day
FMP_API_KEY=your_fmp_key_here
